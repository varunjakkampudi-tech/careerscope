# ---------------------------------------------------------------------------
# CareerScope — environment
#
# Copy to `.env` and edit. Every variable below is parsed and validated by
# `apps/api/src/env.ts` at boot; an invalid value stops the process with a
# message naming the variable, rather than failing later in a request.
#
# The npm scripts load this file with Node's own `--env-file-if-exists`, so
# there is no dotenv dependency and no import-order trap. In Docker, compose
# passes the same variables through `environment:` instead.
#
# Nothing here is secret in the example. The real `.env` is gitignored — keep
# it that way, and never paste one into an issue, a log, or a screenshot.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# development | test | production
# `production` additionally *requires* APP_API_KEY and forbids AUTH_DISABLED.
NODE_ENV=development

PORT=8080

# 0.0.0.0 to accept traffic from outside the container/host; 127.0.0.1 to bind
# loopback only (correct when nginx on the same box is the only client).
HOST=0.0.0.0

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# SQLite database and uploaded resumes live here. Relative paths resolve
# against the process working directory. In Docker this is the mounted volume.
DATA_DIR=./data
ADMIN_SNAPSHOT_PASSPHRASE=


# --- Authentication --------------------------------------------------------

# The single app key. Sent by the web client as `x-api-key` (or
# `Authorization: Bearer …`) and compared in constant time.
#
# Must be at least 24 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
APP_API_KEY=

# Browser login uses an HttpOnly JWT cookie. Create the owner locally first.
LOGIN_ENABLED=true
AUTH_ORIGIN=http://localhost:5173
# Enable only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false
# Legacy development bypass, honored only when LOGIN_ENABLED=false.
AUTH_DISABLED=false

# Comma-separated browser origins allowed to call the API.
#
# Leave EMPTY for the single-origin deploy (the API serves the SPA itself) —
# an empty list means "same origin only", which is stricter than any allowlist.
# Set it only for the GitHub Pages split deploy, e.g.
#   CORS_ORIGINS=https://<user>.github.io
CORS_ORIGINS=


# --- Feature flags ---------------------------------------------------------

# Browser-driven sources: LinkedIn, Naukri and Indeed. Off by default.
#
# These drive a real Chromium over the same public pages a person would open —
# logged out, rate-limited, no stealth patching and no captcha solving. They
# are slower and more fragile than the API boards above, and they are the
# ToS-riskiest surface here, so switching them on is a deliberate act.
#
# Requirements, all three of which the app reports rather than assumes:
#   * Playwright installed  —  npm i && npx playwright install chromium
#   * A display. Chromium runs headed because Naukri's edge refuses a headless
#     one outright. On a desktop that is free; on a server, use the
#     `api-scrape` container target, which supplies an X server (infra/Dockerfile).
#
# What they will and will not return:
#   * Indeed's robots.txt disallows /viewjob, so job detail pages are never
#     fetched there. Its leads carry the search snippet only, stay marked
#     low-confidence, and are therefore capped at 80% — below the default 85%
#     threshold. Drop the match slider on the Search screen to see them.
#   * When a source turns us away, the run says so in as many words instead of
#     reporting zero results.
ENABLE_SCRAPERS=false

# Optional second-opinion rerank. Anthropic requires ANTHROPIC_API_KEY;
# Ollama uses only a local model endpoint with no automatic paid fallback.
ENABLE_LLM_RERANK=false
LLM_PROVIDER=anthropic
# Empty selects the provider default. CPU baseline for Ollama:
# qwen2.5:1.5b-instruct-q4_K_M (slow; quality not established).
LLM_MODEL=
OLLAMA_ORIGIN=http://127.0.0.1:11434

# Local desktop application preparation with Copilot CLI. See docs/APPLICATIONS.md.
ENABLE_APPLICATION_AGENT=false
APPLICATION_COPILOT_PATH=


# --- Provider credentials --------------------------------------------------
#
# All optional. Every keyless source (the ATS boards and the remote boards)
# works with this whole section blank — that is the out-of-the-box path.
# A source with a missing key is shown in the UI as unavailable, naming the
# variable it wants. The values themselves are never logged or echoed back.

# Adzuna — https://developer.adzuna.com (free tier). Both or neither.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — https://jooble.org/api/about (free key on request).
JOOBLE_API_KEY=

# RapidAPI key for JSearch — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# This is the source that legitimately surfaces LinkedIn / Indeed / Glassdoor
# postings; each lead is labelled with the publisher it came from.
RAPIDAPI_KEY=

# Gmail job-alert ingestion. OAuth scope: https://www.googleapis.com/auth/gmail.readonly
# Follow docs/GMAIL.md. Keep all three values on the API host, never in profile JSON.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Anthropic — https://console.anthropic.com. Only read when ENABLE_LLM_RERANK=true.
ANTHROPIC_API_KEY=


# --- Search tuning ---------------------------------------------------------

# How many sources are queried at once. 1–16. Higher finishes sooner and is
# more likely to trip a provider's rate limit.
SEARCH_CONCURRENCY=4

# Automatic searches while the API is running. 0 disables; minimum 360 minutes
# respects Remotive's roughly four-requests-per-day allowance. Uses last search
# settings, or available sources and 85% before the first manual search.
SEARCH_INTERVAL_MINUTES=0

# Hard ceiling on a single search run, in ms. 30_000 – 3_600_000.
RUN_TIMEOUT_MS=900000

# How long a fetched HTTP response stays reusable, in ms. Keeps a re-run
# minutes later from hammering the same board.
HTTP_CACHE_TTL_MS=600000


# --- Serving the SPA from the API (single-origin / EC2 deploy) -------------

# When true the API also serves the built web bundle and falls back to
# index.html for client-side routes. Leave false when nginx or GitHub Pages
# serves the SPA instead.
SERVE_WEB=false

# Path to the built SPA, relative to the API's working directory.
WEB_DIST=../web/dist
