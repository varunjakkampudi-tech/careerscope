# CareerScope local configuration
#
# Copy this file to `.env` and edit only the values needed for your machine.
# The runtime validates required values at boot. `.env` is gitignored: never
# commit credentials, owner data, resume files or service URLs containing
# passwords.

NODE_ENV=development
APP_ORIGIN=http://localhost:5280
REGISTRATION_ENABLED=false

# Local dependencies from infra/compose.canonical.yml.
DATABASE_URL=postgresql://careerscope:change-me@127.0.0.1:55433/careerscope
REDIS_URL=redis://127.0.0.1:56479
LOCAL_AWS_ENDPOINT=http://127.0.0.1:54566

# Search transport. SQS/LocalStack is the default. BullMQ requires a separate
# Redis endpoint and is for search only; resume parsing always uses SQS.
SEARCH_QUEUE_TRANSPORT=sqs
SEARCH_QUEUE_REDIS_URL=

# Cognito is optional locally. Configure all three values together and use an
# HTTPS issuer/redirect outside localhost. The provider token is exchanged
# server-side and is never exposed to the browser.
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_REDIRECT_URI=

# Private encrypted resume storage. The key file must be owned by the API and
# kept outside source control. The production compose file supplies its paths.
RESUME_STORAGE_DIRECTORY=./data/private-objects
RESUME_STORAGE_KEY_FILE=./data/resume-storage.key

# Optional static Pages export and local encrypted admin snapshot.
PUBLIC_EXPORT_OWNER_ID=
ADMIN_SNAPSHOT_PASSPHRASE=

# Optional provider credentials. Leave empty to use keyless sources.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
RAPIDAPI_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Operational tuning (defaults are safe for local development).
SEARCH_CONCURRENCY=4
SEARCH_INTERVAL_MINUTES=0
RUN_TIMEOUT_MS=900000
HTTP_CACHE_TTL_MS=600000
