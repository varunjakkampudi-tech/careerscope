# Editor defaults, matching .prettierrc.json so a file looks the same before
# Prettier runs as after. Prettier is still the authority — this only covers
# editors and file types Prettier does not format (Dockerfile, .env, shell).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Two trailing spaces are a hard line break in Markdown; stripping them
# silently reflows the paragraph.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
