# Applied only to packages/core/src/bull-queue.integration.test.ts (npm run test:integration:bull-queue).
# That suite waits on BullMQ job completion and creates a database per run, so shared Docker hosts
# need more than the production defaults. Every other suite keeps the production defaults
# (statement timeout 10 s, connect timeout 5 s). Values already in the process environment win.
DATABASE_STATEMENT_TIMEOUT_MS=60000
DATABASE_CONNECT_TIMEOUT_MS=30000
INTEGRATION_JOB_WAIT_MS=60000
