# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
# Typecheck-only declaration output for composite TypeScript projects. The
# Next.js web app owns the production build; declarations here are disposable.
dist-types/

# Runtime data, local uploads and exports. NEVER commit production data.
# Test fixtures belong beside the tests that consume them. Runtime data stays local.
data/
!data/.gitkeep

# Playwright browser session state
.auth/
playwright-report/
test-results/
_site/
# Scratch written by the browser MCP tools when the app is driven interactively
# — page snapshots and console dumps, not test output. Left unignored it lands
# in `prettier --check`, so a debugging session turns CI red.
.playwright-mcp/

# Environment / secrets
.env
.env.*

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp

# Generated AI context stays local and must not be re-packed.
.repomix/
repomix-output*

# Local assistant instructions and editor configuration are not product sources.
CLAUDE.md
.vscode/
.ai/

# Deployment build contexts are produced on demand and must never be committed.
deploy.tgz
*.tgz

# Design scratch artefacts and external project clones - not part of this repo
.codeatlas/
page-designs/
careerscope-pixel-perfect/
2a333ef7-7f3c-459e-9f7b-e7a21b4e1741/
# External design handoff archives must not be committed as a binary archive.
CareerScope-Design-System*.zip
