{
  "name": "job-radar",
  "version": "1.3.4",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Resume-matched job lead finder — upload a resume, search multiple job sources, surface leads that match above a configurable threshold.",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "predev": "npm run build:api",
    "dev": "concurrently --kill-others -n api,web -c cyan,magenta \"npm run dev -w @job-radar/api\" \"npm run dev -w @job-radar/web\"",
    "build": "npm run build -w @job-radar/shared && npm run build -w @job-radar/resume && npm run build -w @job-radar/matching && npm run build -w @job-radar/providers && npm run build -w @job-radar/api && npm run build -w @job-radar/web",
    "build:api": "npm run build -w @job-radar/shared && npm run build -w @job-radar/resume && npm run build -w @job-radar/matching && npm run build -w @job-radar/providers && npm run build -w @job-radar/api",
    "build:web": "npm run build -w @job-radar/shared && npm run build -w @job-radar/web",
    "start": "node --env-file-if-exists=.env apps/api/dist/index.js",
    "mobile:export": "node --env-file-if-exists=.env scripts/export-mobile.mjs",
    "mobile:watch": "npm run mobile:export -- --watch",
    "mobile:admin": "node --env-file-if-exists=.env scripts/export-admin.mjs",
    "mobile:admin:test": "node --test scripts/snapshot-crypto.test.mjs scripts/export-admin.test.mjs",
    "pages:test": "node --test scripts/export-mobile.test.mjs scripts/export-admin.test.mjs scripts/snapshot-crypto.test.mjs scripts/admin-session.test.mjs scripts/theme.test.mjs scripts/stage-pages.test.mjs scripts/publish-pages.test.mjs scripts/sync-version.test.mjs scripts/job-workspace.test.mjs",
    "test:full-disk": "node infra/v3/check-full-disk.mjs",
    "skills:check": "node scripts/check-skills.mjs",
    "pages:workspace:test": "node scripts/check-public-workspace.mjs",
    "pages:visual": "node scripts/check-pages-ui.mjs",
    "pages:visual:update": "node scripts/check-pages-ui.mjs --update-baselines",
    "pages:preview": "node scripts/preview-pages.mjs",
    "pages:stage": "node scripts/stage-pages.mjs",
    "pages:publish": "node scripts/publish-pages.mjs",
    "product:discover": "node scripts/product.mjs discover",
    "product:council": "node scripts/product.mjs council",
    "product:plan": "node scripts/product.mjs plan",
    "product:release": "node scripts/product.mjs release",
    "product:verify": "node scripts/product.mjs verify",
    "agile:status": "node scripts/agile.mjs status",
    "agile:plan": "node scripts/agile.mjs plan",
    "agile:scrum": "node scripts/agile.mjs scrum",
    "agile:feature": "node scripts/agile.mjs feature",
    "agile:review": "node scripts/agile.mjs review",
    "agile:retro": "node scripts/agile.mjs retro",
    "agile:release": "node scripts/agile.mjs release",
    "agile:carry": "node scripts/agile.mjs carry",
    "agile:ui": "node scripts/engineering-ui.mjs",
    "engineering:center": "node scripts/engineering-ui.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "agents:check": "node scripts/check-agents.mjs",
    "control-center": "node scripts/control-center.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "mobile:test": "node --test scripts/export-mobile.test.mjs",
    "typecheck": "tsc --build --force && tsc -p tsconfig.test.json && tsc -p tsconfig.test.web.json",
    "test": "vitest run",
    "test:ui": "npm run build && node --import tsx scripts/check-ui.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx --env-file-if-exists=.env apps/api/src/db/migrate.ts",
    "auth:reset": "tsx --env-file-if-exists=.env apps/api/src/reset-owner.ts",
    "seed:companies": "tsx --env-file-if-exists=.env apps/api/src/db/seed.ts",
    "mcp": "node --env-file-if-exists=.env apps/api/dist/mcp/index.js",
    "clean": "npm run clean --workspaces --if-present && rm -f *.tsbuildinfo",
    "release:gate:test": "node scripts/check-release-gate.mjs",
    "agile:gate:test": "node scripts/check-agile-gates.mjs",
    "deploy:gate:test": "node scripts/check-deploy-gate.mjs",
    "eol:check": "node scripts/check-line-endings.mjs",
    "progress:check": "node scripts/check-progress.mjs",
    "gates:test": "npm run release:gate:test && npm run agile:gate:test && npm run deploy:gate:test && npm run eol:check && npm run progress:check && npm run agents:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^14.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
