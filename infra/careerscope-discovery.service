[Unit]
Description=CareerScope scheduled discovery (per-owner opt-in, unattended search)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Reuses CS-24's webhook env file - same alerting channel, no separate
# webhook to configure unless BACKUP_WEBHOOK_URL-style separation is wanted
# later.
EnvironmentFile=-/etc/careerscope-monitor.env
ExecStart=/usr/bin/docker exec careerscope-api-1 node --import tsx /app/scripts/run-scheduled-discovery.ts

# This runs inside the api container via `docker exec`, not directly as this
# unit's own process, so the sandboxing that matters is the api container's
# own (unprivileged user, read_only, cap_drop ALL - see
# compose.production.yml). No docker-socket access is needed here at all,
# unlike CS-24/CS-25's monitor/backup, so this unit itself can be sandboxed
# more tightly than theirs.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
