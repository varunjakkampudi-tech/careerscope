[Unit]
Description=Run the CareerScope scheduler health check hourly

[Timer]
# Hourly is enough for the watched timers: the daily and weekly ones tolerate
# hours of grace, and the minute-scale ones are also watched by the monitor
# itself. Checking more often would only re-report the same steady state - the
# checker is edge-triggered anyway (SCHEDULER_RENOTIFY_SECONDS, default 6h).
OnBootSec=10min
OnUnitActiveSec=1h
Persistent=true

[Install]
WantedBy=timers.target
